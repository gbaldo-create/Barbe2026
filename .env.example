# Copia questo file in .env.local per lo sviluppo, e inserisci le stesse variabili su Vercel.
SESSION_SECRET=        # stringa casuale lunga (min 24 caratteri)
USERS_KEY=             # stringa casuale lunga (min 24 caratteri): cifra data/private/users.enc.json
ADMIN_USERNAME=admin   # amministratore di emergenza
ADMIN_PASSWORD=        # min 10 caratteri
ADMIN_DISPLAY_NAME=Amministratore
ANTHROPIC_API_KEY=     # chiave Anthropic, solo lato server
GITHUB_TOKEN=          # solo su Vercel: token GitHub "fine-grained" con Contents read/write sul repo Barbe2026
# LOCAL_FS=0           # in locale: 0 = salva su GitHub invece che sui file della cartella
