{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':(exclude)data/items.json' ':(exclude)data/memories.json' ':(exclude)data/private' ':(exclude)public/images'",
  "functions": {
    "api/ai.ts": { "maxDuration": 60 }
  },
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }]
}
